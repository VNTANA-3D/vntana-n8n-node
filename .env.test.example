# VNTANA E2E Test Credentials
# Copy this file to .env.test and fill in your test credentials

# Authentication
VNTANA_TEST_EMAIL=your-test-email@example.com
VNTANA_TEST_PASSWORD=your-test-password

# Organization slug (from your platform URL, e.g. app.vntana.com/<slug>/...).
# This is what users enter in the node credential; the org UUID is resolved automatically.
VNTANA_TEST_ORG_SLUG=your-organization-slug

# Organization UUID (required for auth token refresh in the standalone test client)
VNTANA_TEST_ORG_UUID=your-organization-uuid

# Workspace (Client) UUID for testing product operations
VNTANA_TEST_WORKSPACE_UUID=your-workspace-uuid

# Pipeline UUID for product uploads (optional, uses default if not set)
VNTANA_TEST_PIPELINE_UUID=your-pipeline-uuid

# Optional: Custom API base URL (defaults to production)
# VNTANA_API_BASE_URL=https://api-platform.vntana.com
