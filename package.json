{
	"name": "n8n-nodes-vntana",
	"version": "0.3.4",
	"description": "n8n community node for VNTANA 3D content management platform",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"vntana",
		"3d",
		"content-management"
	],
	"license": "MIT",
	"homepage": "https://github.com/VNTANA-3D/vntana-n8n-node",
	"author": {
		"name": "VNTANA",
		"email": "support@vntana.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VNTANA-3D/vntana-n8n-node.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"lint": "eslint nodes credentials",
		"lintfix": "eslint nodes credentials --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "vitest run tests/e2e",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/VntanaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Vntana/Vntana.node.js"
		]
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@types/node": "^25.5.2",
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"@typescript-eslint/parser": "^8.58.1",
		"@vitest/coverage-v8": "^4.1.4",
		"dotenv": "^17.4.1",
		"eslint": "^10.2.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.6",
		"gulp": "^5.0.1",
		"n8n-workflow": "^1.17.0",
		"nock": "^14.0.12",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"n8n-workflow": {
			"lodash": "4.18.1",
			"form-data": "4.0.5"
		}
	}
}
